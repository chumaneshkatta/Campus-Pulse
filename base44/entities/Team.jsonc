{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "teamType": {
      "type": "string",
      "enum": [
        "college",
        "community"
      ],
      "default": "college"
    },
    "captainId": {
      "type": "string"
    },
    "playerIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "logoColor": {
      "type": "string",
      "default": "#1e40af"
    },
    "homeVenue": {
      "type": "string"
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "draws": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "sport"
  ]
}